# Railway variables for the API service (Railway suggests these for import from .env.example).
# The ${{...}} values are Railway reference variables: they resolve to the Postgres / API service values.
# "Postgres" must match the exact name of the database service in the Railway project.
DATABASE_URL=${{Postgres.DATABASE_URL}}
PORT=8080
SEED_DEMO_DATA=true
AUTH_SIGNING_KEY=
AUTH_ADMIN_EMAIL=professor.gilbertojr@gmail.com
AUTH_ADMIN_PASSWORD=
AUTH_DEV_EMAIL=
AUTH_DEV_PASSWORD=
